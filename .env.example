# ============================================
# Synkra AIOS Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env with real credentials
# ============================================

# --------------------------------------------
# LLM Providers
# --------------------------------------------

# DeepSeek API (for claude-free command)
# Get your key at: https://platform.deepseek.com/api_keys
# Cost: ~$0.14/M tokens with tool calling support
DEEPSEEK_API_KEY=

# OpenRouter API (for multi-model routing)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Anthropic API (direct, if not using Claude Max subscription)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API Key - Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --------------------------------------------
# Search & Research Tools
# --------------------------------------------

# Exa Search API (web search for agents)
# Get your key at: https://exa.ai/
EXA_API_KEY=

# Context7 (library documentation lookup)
# Usually free, no key required for basic usage
CONTEXT7_API_KEY=

# --------------------------------------------
# Database & Backend
# --------------------------------------------

# Supabase (database, auth, storage)
# Get from your Supabase project settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------
# Version Control & CI/CD
# --------------------------------------------

# GitHub Token (for GitHub CLI and API access)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# --------------------------------------------
# Project Management
# --------------------------------------------

# ClickUp API (if using ClickUp integration)
# Get from: ClickUp Settings > Apps > API Token
CLICKUP_API_KEY=

# --------------------------------------------
# Automation & Workflows
# --------------------------------------------

# N8N (workflow automation)
# From your N8N instance settings
N8N_API_KEY=
N8N_WEBHOOK_URL=

# --------------------------------------------
# Monitoring & Analytics — Sentry
# --------------------------------------------
# Criar projeto em: https://sentry.io → New Project → Next.js
# DSN: Project Settings > Client Keys (DSN)
# Auth Token: User Settings > Auth Tokens (escopo: project:releases, org:read)
# Org/Project slugs: URL do Sentry (sentry.io/{org}/{project})

# DSN público (browser) — prefixo NEXT_PUBLIC_ obrigatório
NEXT_PUBLIC_SENTRY_DSN=

# DSN privado (servidor) — mesmo valor que o acima
SENTRY_DSN=

# Auth token para upload de source maps no build (NUNCA expor no cliente)
SENTRY_AUTH_TOKEN=

# Slug da organização Sentry (ex: minha-empresa)
SENTRY_ORG=

# Slug do projeto Sentry (ex: jornada-com-deus)
SENTRY_PROJECT=

# --------------------------------------------
# Cloud Providers
# --------------------------------------------

# Railway (deployment)
RAILWAY_TOKEN=

# Vercel (deployment)
VERCEL_TOKEN=

# --------------------------------------------
# AIOS Core Configuration
# --------------------------------------------
NODE_ENV=development
AIOS_VERSION=2.2.0

# --------------------------------------------
# Hotmart — Sistema de Pagamento (Jornada com Deus Plus)
# --------------------------------------------

# Token de validação de webhooks Hotmart
# Obtenha em: Hotmart > Produto > Ferramentas > Webhooks > HOTTOK
HOTMART_HOTTOK=

# URLs de checkout por plano (Hotmart > Produto > Copiar Link de Vendas)
NEXT_PUBLIC_HOTMART_CHECKOUT_MENSAL=
NEXT_PUBLIC_HOTMART_CHECKOUT_TRIMESTRAL=
NEXT_PUBLIC_HOTMART_CHECKOUT_ANUAL=

# --------------------------------------------
# Herospark — Sistema de Pagamento Principal (Jornada com Deus Plus)
# --------------------------------------------

# Token de segurança para validar webhooks Herospark
# Como gerar: openssl rand -hex 32  (qualquer string aleatória segura)
# Como usar: configure a URL do webhook no painel Herospark assim:
#   https://app.minhajornadadiaria.com.br/api/webhooks/herospark?token=SEU_TOKEN
# O valor de SEU_TOKEN deve ser o mesmo que HEROSPARK_WEBHOOK_SECRET abaixo.
HEROSPARK_WEBHOOK_SECRET=

# --------------------------------------------
# Google AI Studio — VEO3 / Gemini
# --------------------------------------------
# Usada pelo SQuAD veo3-editorial (geração de vídeos Veo 3)
# e pelo mcp-image (geração de imagens Gemini)
# Obtenha em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# --------------------------------------------
# Custom Configuration
# --------------------------------------------
# Add your custom API keys below
